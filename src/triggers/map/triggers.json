[
  {
    "name": "cartel_capture_end",
    "patterns": [{"pattern": "^   Cartel", "type": "regex"}]
  },
  {
    "name": "cartel_capture_member",
    "patterns": [{"pattern": "^      (.+)$", "type": "regex"}]
  },
  {
    "name": "cartel_capture_other",
    "patterns": [
      {"pattern": "^[A-Z].+Cartel", "type": "regex"},
      {"pattern": "^   [A-Z]", "type": "regex"},
      {"pattern": "^      .+ \\([a-z]+/\\d+\\)$", "type": "regex"}
    ]
  },
  {
    "name": "cartel_capture_start",
    "patterns": [{"pattern": "^   Member systems:$", "type": "regex"}]
  },
  {
    "name": "di_system_capture_details",
    "patterns": [{"pattern": "^  .+$", "type": "regex"}]
  },
  {
    "name": "di_system_capture_planet",
    "patterns": [{"pattern": "^([^,]+, .+ system, .+ cartel(?:, .+ syndicate)?)$", "type": "regex"}]
  },
  {
    "name": "di_system_capture_start",
    "patterns": [{"pattern": "^System information for the (.+) system:$", "type": "regex"}]
  },
  {
    "name": "explore_system_closed",
    "patterns": [{"pattern": "^I'm afraid the (.+) system is closed to visitors at the moment\\.$", "type": "regex"}]
  },
  {
    "name": "jump_no_direct_link",
    "patterns": [{"pattern": "^There isn't a direct link to (.+) from here\\.$", "type": "regex"}]
  },
  {
    "name": "jump_sol_credits_required",
    "patterns": [{
      "pattern": "A message from link control informs you that the link is only open to commanders",
      "type": "substring"
    }]
  },
  {
    "name": "special_exit_invalid_command",
    "patterns": [{"pattern": "^I'm sorry I don't understand you\\. Can you put that a different way\\?$", "type": "regex"}]
  },
  {
    "name": "speedwalk_customs_intercept",
    "patterns": [{"pattern": "Your routine is suddenly interrupted by the appearance", "type": "substring"}]
  },
  {
    "name": "speedwalk_no_ship",
    "patterns": [{
      "pattern": "You don't have a space ship",
      "type": "substring"
    }]
  },
  {
    "name": "speedwalk_out_of_fuel",
    "patterns": [{"pattern": "^You have run out of fuel, and are unable to move\\.$", "type": "regex"}]
  },
  {
    "name": "topology_cartels_start",
    "patterns": [{"pattern": "^Cartels operating in this galaxy, grouped by syndicate:$", "type": "regex"}]
  },
  {
    "name": "topology_cartels_syndicate",
    "patterns": [{"pattern": "^(\\S.*) syndicate:$", "type": "regex"}]
  },
  {
    "name": "topology_cartels_line",
    "patterns": [{"pattern": "^      (\\S.*)$", "type": "regex"}]
  },
  {
    "name": "topology_syndicates_start",
    "patterns": [{"pattern": "^Syndicates operating in this galaxy:$", "type": "regex"}]
  },
  {
    "name": "topology_syndicates_line",
    "patterns": [{"pattern": "^   #\\d+ (.+)$", "type": "regex"}]
  },
  {
    "name": "topology_capture_blank",
    "patterns": [{"pattern": "^$", "type": "regex"}]
  },
  {
    "name": "whereis_found",
    "patterns": [
      {"pattern": "^.+ is in the (.+) system in the .+ cartel of the .+ syndicate\\.$", "type": "regex"}
    ]
  },
  {
    "name": "whereis_not_found",
    "patterns": [
      {"pattern": "^I have no record of a planet called .+\\. Perhaps its sun went nova\\?$", "type": "regex"}
    ]
  },
  {
    "name": "whereis_route_hint",
    "patterns": [
      {"pattern": "^From .+ to .+: (.+)$", "type": "regex"}
    ]
  }
]
